{
  "hosting": {
    "public": ".",
    "ignore": [
      ".git",
      ".github",
      ".agents",
      ".claude",
      "firebase.json",
      "skills-lock.json"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
